# Copy this file to .env and fill in real values. .env is gitignored;
# this file is not - never put real secrets in .env.example.

ANTHROPIC_API_KEY=

# Used by src/sql_connection.py and src/mcp_server.py. Must include
# Encrypt=yes or sql_connection.connect() refuses it (REQ-015).
#
# Windows/Integrated Auth example:
# SQL_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=your-server;DATABASE=your-db;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes
#
# SQL Auth example:
# SQL_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=your-server;DATABASE=your-db;UID=your-user;PWD=your-password;Encrypt=yes;TrustServerCertificate=yes
SQL_CONNECTION_STRING=
